# Copy to .env and fill in. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/powermycrm
# At least 32 random characters.
JWT_SECRET=
# Comma-separated web origins allowed to call the API.
WEB_ORIGIN=http://localhost:3000
PORT=4000
# true behind HTTPS in production.
COOKIE_SECURE=false
# Base64-encoded 32 random bytes (openssl rand -base64 32). Encrypts integration credentials and webhook secrets.
CREDENTIALS_KEY=
# Public base URL of this API as reached from the internet, used in webhook and form endpoint URLs shown to admins.
API_PUBLIC_URL=http://localhost:4000
# Set to true to run the API without background jobs (the queue is normally in-process, on PostgreSQL via pg-boss).
QUEUE_DISABLED=false
# Platform-wide SMTP, used when a workspace has not connected its own email. Leave empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PowerMyCRM <no-reply@yourdomain.com>"
# Directory for uploaded lead files (local-disk storage). Defaults to ./uploads under the API.
STORAGE_DIR=
