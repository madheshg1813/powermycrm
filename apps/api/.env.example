# Copy to .env and fill in. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/powermycrm
# At least 32 random characters.
JWT_SECRET=
# Comma-separated web origins allowed to call the API.
WEB_ORIGIN=http://localhost:3000
PORT=4000
# true behind HTTPS in production.
COOKIE_SECURE=false
